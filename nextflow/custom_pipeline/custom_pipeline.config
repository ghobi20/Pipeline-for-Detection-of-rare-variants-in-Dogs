params {
	refGenomeBuild = 'canFam4'
	annovar_dir = '/home/sgamino/annovar'
	annDatabaseDir = null 
	Family_metadata = '/mnt/data/cgonzaga/sgamino/Dog_epilepsy_project/scripts/nextflow/custom_pipeline/Family_Metadata.csv'
	GVcf_joint_path = '/mnt/data/cgonzaga/sgamino/Dog_epilepsy_project/scripts/nextflow/sarek_results_1/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz'
	GVcf_joint_idx_path = '/mnt/data/cgonzaga/sgamino/Dog_epilepsy_project/scripts/nextflow/sarek_results_1/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz.tbi'
	refGenomePath = '/mnt/data/cgonzaga/sgamino/Dog_epilepsy_project/resources/reference/canFam4/canFam4.fa'
	refGenomeIdxPath = '/mnt/data/cgonzaga/sgamino/Dog_epilepsy_project/resources/reference/canFam4.fa.fai'
}

workflow.output.mode = 'copy'

process {
    executor = 'slurm'
    queue    = 'defq'
    resourceLimits = [ cpus: 4, memory: 120.GB, time: 48.h ]

    withName: 'VariantAnnotation_Complete' {
		memory = 100.GB
		cpus = 3
	} 

    withName: 'VariantAnnotation_Individual' {
                memory = 100.GB
                cpus = 3
        }

    withName: 'GT_Assignment_to_AnnVariants' {
		memory = 32.GB
		cpus = 3
	}

    errorStrategy = 'finish'

}

executor {
    queueSize       = 30
    submitRateLimit = '10 sec'
}
